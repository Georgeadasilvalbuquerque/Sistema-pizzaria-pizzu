# Neon (PostgreSQL): copie as strings em Project > Connection details.
#
# DATABASE_URL: prefira a URL com "Pooled connection" (host com "-pooler").
# DIRECT_URL: use "Direct connection" (host sem "-pooler") para prisma db push / migrate.
# Se o Neon mostrar so uma URL, cole a mesma nas duas linhas.
# Sempre mantenha sslmode=require na query string.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Opcional
# PORT=3000
